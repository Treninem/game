; ImPuls PC — offline single-player RPG
; Stable 0.10.2: delta-only installed updates, visible progress and centralized UI auto-alignment
config_version=5

[application]
config/name="ImPuls"
config/version="0.10.2-stable"
config/icon="res://assets/branding/impuls_icon.png"
run/main_scene="res://scenes/stage1.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="res://assets/branding/impuls_icon.png"
boot_splash/bg_color=Color(0.015, 0.02, 0.035, 1)
boot_splash/fullsize=false

[autoload]
GameState="*res://scripts/game_state.gd"
SaveManager="*res://scripts/save_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
UILayoutGuard="*res://scripts/ui_layout_guard.gd"
UpdateManager="*res://scripts/update_manager.gd"
InventorySystem="*res://scripts/inventory_system.gd"
DialogueManager="*res://scripts/dialogue_manager.gd"
WorldData="*res://scripts/world_data.gd"
MapSystem="*res://scripts/map_system.gd"
VFXLibrary="*res://scripts/vfx_library.gd"
ThirdPartyVFX="*res://scripts/third_party_vfx.gd"
MagicSystem="*res://scripts/magic_system.gd"
EnvironmentState="*res://scripts/environment_state.gd"
EnvironmentExposure="*res://scripts/environment_exposure.gd"
EnvironmentMarks="*res://scripts/environment_mark_pool.gd"
WorldVFX="*res://scripts/world_vfx.gd"
WeatherVFX="*res://scripts/weather_vfx.gd"
WeatherHailVFX="*res://scripts/weather_hail_vfx.gd"
AmbientVFX="*res://scripts/ambient_vfx.gd"
NatureVFX="*res://scripts/nature_vfx.gd"
LandmarkVFX="*res://scripts/landmark_vfx.gd"
ScreenVFX="*res://scripts/screen_vfx.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false
