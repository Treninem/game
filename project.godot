; ImPuls PC — offline single-player RPG
; Stage 4 menus, settings, saves and updates
config_version=5

[application]
config/name="ImPuls"
config/version="0.4.0-stage4"
config/icon="res://assets/branding/impuls_icon.svg"
run/main_scene="res://scenes/stage1.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="res://assets/branding/impuls_icon.svg"
boot_splash/bg_color=Color(0.015, 0.02, 0.035, 1)
boot_splash/fullsize=false

[autoload]
GameState="*res://scripts/game_state.gd"
SaveManager="*res://scripts/save_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
UpdateManager="*res://scripts/update_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false
